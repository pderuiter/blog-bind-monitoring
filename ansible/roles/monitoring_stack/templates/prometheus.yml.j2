# {{ monitoring_stack_dir }}/prometheus/prometheus.yml
# {{ ansible_managed }}

global:
  scrape_interval: {{ monitoring_stack_scrape_interval }}
  evaluation_interval: {{ monitoring_stack_scrape_interval }}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'bind'
    static_configs:
      - targets: ['host.docker.internal:9119']
    relabel_configs:
      - target_label: instance
        replacement: '{{ monitoring_stack_instance }}'
