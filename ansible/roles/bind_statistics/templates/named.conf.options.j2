// {{ bind_install_options_conf }}
// {{ ansible_managed }}

// Enable statistics channel (a top-level statement, not an option)
statistics-channels {
    inet 127.0.0.1 port {{ bind_statistics_port }} allow { localhost; };
    inet ::1 port {{ bind_statistics_port }} allow { localhost; };
};

options {
    directory "{{ bind_install_data_dir }}";

    // Enable zone statistics
    zone-statistics {{ bind_statistics_zone_statistics }};

    // Query logging that survives rndc reconfig
    querylog {{ 'yes' if bind_statistics_querylog else 'no' }};

    // Other options...
    recursion yes;
    dnssec-validation auto;
};

logging {
    channel query_log {
        file "{{ bind_statistics_log_dir }}/queries.log" versions 10 size 100m;
        severity info;
        print-time yes;
        print-category yes;
        print-severity yes;
    };

    channel security_log {
        file "{{ bind_statistics_log_dir }}/security.log" versions 5 size 50m;
        severity info;
        print-time yes;
        print-category yes;
    };

    category queries { query_log; };
    category security { security_log; };
    category query-errors { query_log; };
};
